<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <appSettings>
    <!--
      Токен Telegram-бота для удалённого управления списком машин.
      Оставьте пустым, чтобы не запускать бота (приложение работает и без него).
      Получить токен: @BotFather -> /newbot. Держите его в секрете и не коммитьте.
    -->
    <add key="BotToken" value="" />

    <!-- Подсеть для сканирования, без последнего октета. Например: 192.168.1. -->
    <add key="ScanSubnet" value="192.168.0." />

    <!-- Задержка перед выключением удалённой машины, секунды. -->
    <add key="ShutdownDelaySeconds" value="100" />
  </appSettings>
</configuration>
